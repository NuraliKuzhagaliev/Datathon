{
  "name": "cashproof-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.13.0" },
  "scripts": {
    "generate:api": "openapi-typescript packages/contracts/openapi.json -o apps/web/src/api/generated/schema.d.ts && node apps/web/scripts/generate-validators.mjs",
    "dev:web": "pnpm --filter @cashproof/web dev",
    "build:web": "pnpm generate:api && pnpm --filter @cashproof/web build",
    "dev:desktop": "pnpm build:web && electron apps/desktop",
    "build:desktop": "pnpm build:web && node apps/desktop/scripts/package.mjs",
    "build:desktop:connected": "pnpm build:web && node apps/desktop/scripts/package.mjs --connected",
    "check:ui": "pnpm generate:api && pnpm --filter @cashproof/web typecheck && vitest run --config apps/web/vitest.config.ts && node --test apps/desktop/tests/*.test.cjs",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "test:desktop": "playwright test --config apps/desktop/playwright.config.ts",
    "test:integration": "playwright test --config apps/web/playwright.integration.config.ts",
    "test:production": "pnpm build:web && playwright test --config apps/web/playwright.production.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
