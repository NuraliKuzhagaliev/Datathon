{
  "openapi": "3.1.0",
  "info": {
    "title": "CashProof integration contract",
    "version": "1.0.0",
    "description": "Frozen handoff contract. Jury responses stay minimal. Synthetic fixtures never constitute model evaluation."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "UploadAccepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "job_id"
        ]
      },
      "EvidenceFrame": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timestamp_sec": {
            "type": "number",
            "minimum": 0
          },
          "image_base64": {
            "type": "string",
            "minLength": 4,
            "contentEncoding": "base64",
            "contentMediaType": "image/jpeg"
          }
        },
        "required": [
          "timestamp_sec",
          "image_base64"
        ]
      },
      "Violation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "timecode_sec": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_frames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceFrame"
            },
            "minItems": 1,
            "maxItems": 3
          }
        },
        "required": [
          "type",
          "timecode_sec",
          "description",
          "evidence_frames"
        ]
      },
      "Processing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "const": "processing",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status"
        ]
      },
      "Failed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "const": "failed",
            "type": "string"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "job_id",
          "status",
          "error"
        ]
      },
      "DonePositive": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "const": "done",
            "type": "string"
          },
          "verdict": {
            "const": "violation",
            "type": "string"
          },
          "violations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "minItems": 1
          }
        },
        "required": [
          "job_id",
          "status",
          "verdict",
          "violations"
        ]
      },
      "DoneNegative": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "const": "done",
            "type": "string"
          },
          "verdict": {
            "const": "no_violation",
            "type": "string"
          },
          "violations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "maxItems": 0
          }
        },
        "required": [
          "job_id",
          "status",
          "verdict",
          "violations"
        ]
      },
      "JuryResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Processing"
          },
          {
            "$ref": "#/components/schemas/Failed"
          },
          {
            "$ref": "#/components/schemas/DonePositive"
          },
          {
            "$ref": "#/components/schemas/DoneNegative"
          }
        ]
      },
      "Rule": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "document_title": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "clause": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "effective_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "applicability": {
            "type": "string"
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "source_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "rule_id",
          "display_name",
          "document_title",
          "source_url",
          "clause",
          "revision",
          "effective_date",
          "applicability",
          "exclusions",
          "enabled",
          "source_sha256"
        ]
      },
      "RuleRegistry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rule"
            }
          }
        },
        "required": [
          "version",
          "rules"
        ]
      },
      "ReviewInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "unreviewed",
              "confirmed",
              "dismissed",
              "uncertain"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "decision",
          "note"
        ]
      },
      "Review": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "unreviewed",
              "confirmed",
              "dismissed",
              "uncertain"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "event_id",
          "decision",
          "note",
          "updated_at"
        ]
      },
      "UiEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string"
          },
          "jury_violation_index": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "type": "string"
          },
          "timecode_sec": {
            "type": "number",
            "minimum": 0
          },
          "context_start_sec": {
            "type": "number",
            "minimum": 0
          },
          "context_end_sec": {
            "type": "number",
            "minimum": 0
          },
          "observation": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterevidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "evidence_frames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceFrame"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "review": {
            "$ref": "#/components/schemas/Review"
          }
        },
        "required": [
          "event_id",
          "jury_violation_index",
          "type",
          "timecode_sec",
          "context_start_sec",
          "context_end_sec",
          "observation",
          "rationale",
          "limitations",
          "counterevidence",
          "rule_ids",
          "evidence_frames",
          "review"
        ]
      },
      "CoverageSegment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_sec": {
            "type": "number",
            "minimum": 0
          },
          "end_sec": {
            "type": "number",
            "minimum": 0
          },
          "state": {
            "type": "string",
            "enum": [
              "assessed",
              "limited",
              "unassessed"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "start_sec",
          "end_sec",
          "state",
          "reason"
        ]
      },
      "TimeMapSegment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_start_sec": {
            "type": "number",
            "minimum": 0
          },
          "source_end_sec": {
            "type": "number",
            "minimum": 0
          },
          "preview_start_sec": {
            "type": "number",
            "minimum": 0
          },
          "preview_end_sec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "source_start_sec",
          "source_end_sec",
          "preview_start_sec",
          "preview_end_sec"
        ]
      },
      "ReviewCue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cue_id": {
            "type": "string"
          },
          "timecode_sec": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_frames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceFrame"
            },
            "minItems": 1,
            "maxItems": 3
          }
        },
        "required": [
          "cue_id",
          "timecode_sec",
          "reason",
          "limitations",
          "evidence_frames"
        ]
      },
      "CaseSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "done",
              "failed"
            ]
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "violation",
                  "no_violation"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "job_id",
          "filename",
          "created_at",
          "status",
          "verdict"
        ]
      },
      "CaseList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaseSummary"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CaseDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "done",
              "failed"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "queued",
              "decoding",
              "screening",
              "verifying",
              "packaging",
              "complete",
              "failed"
            ]
          },
          "progress_percent": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "elapsed_sec": {
            "type": "number",
            "minimum": 0
          },
          "duration_sec": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "model_result": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/DonePositive"
                  },
                  {
                    "$ref": "#/components/schemas/DoneNegative"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UiEvent"
            }
          },
          "coverage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoverageSegment"
            }
          },
          "media_ready": {
            "type": "boolean"
          },
          "time_map": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeMapSegment"
            }
          },
          "rule_registry_version": {
            "type": "string"
          },
          "model_version": {
            "type": "string"
          },
          "input_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_synthetic": {
            "type": "boolean"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rule"
            }
          },
          "review_cues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewCue"
            }
          }
        },
        "required": [
          "job_id",
          "filename",
          "created_at",
          "status",
          "stage",
          "progress_percent",
          "elapsed_sec",
          "duration_sec",
          "model_result",
          "error",
          "events",
          "coverage",
          "media_ready",
          "time_map",
          "rule_registry_version",
          "model_version",
          "input_sha256",
          "is_synthetic",
          "rules",
          "review_cues"
        ]
      },
      "HealthLive": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthReady": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "offline",
              "server"
            ]
          },
          "contract_version": {
            "type": "string"
          }
        },
        "required": [
          "ready",
          "mode",
          "contract_version"
        ]
      }
    }
  },
  "paths": {
    "/api/v1/analyze": {
      "post": {
        "operationId": "analyzeVideo",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadAccepted"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Upload exceeds configured limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Queue cannot admit request within its budget; Retry-After header supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Worker/model unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "operationId": "getJuryJob",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JuryResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/ui/cases": {
      "get": {
        "operationId": "listCases",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseList"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/ui/cases/{job_id}": {
      "get": {
        "operationId": "getCase",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "delete": {
        "operationId": "deleteCase",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "deleted": {
                      "const": true,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "deleted"
                  ]
                }
              }
            }
          },
          "401": {
